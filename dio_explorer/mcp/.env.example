# ─────────────────────────────────────────────
# DIO Explorer MCP Server — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ─────────────────────────────────────────────

# Modo de transporte: "stdio" (padrão, para Bob/Claude) ou "http" (para API remota)
MCP_TRANSPORT=stdio

# ── Configurações HTTP ────────────────────────
# Porta em que o servidor HTTP irá escutar
MCP_PORT=3333

# Host (0.0.0.0 = todas as interfaces, 127.0.0.1 = apenas local)
MCP_HOST=0.0.0.0

# ── Autenticação Bearer Token ─────────────────
# Defina para proteger o servidor com Bearer auth.
# Gere um token seguro: openssl rand -hex 32
# Deixe em branco para desativar (apenas para desenvolvimento)
MCP_API_KEY=

# ── HTTPS / TLS ───────────────────────────────
# Caminhos para certificado e chave TLS.
# Se não definidos, o servidor roda em HTTP simples.
# Para gerar um certificado auto-assinado (dev):
#   openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
MCP_HTTPS_CERT=
MCP_HTTPS_KEY=

# ── Caminhos de dados ─────────────────────────
# Override do caminho para o trilhas_dio.json
# (padrão: resolvido automaticamente a partir do build)
DIO_DATA_PATH=

# Override do diretório de saída para desafios e certificados gerados
# (padrão: ../docs relativo ao build)
DIO_OUTPUT_DIR=
